# Local development credentials only. Never put production credentials here.
DIRECTUS_KEY=local-development-key
DIRECTUS_SECRET=replace-with-a-local-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=directus

POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus-local-development

# Override when the Directus extension directory is not in the adjacent
# ../directus workspace.
DIRECTUS_EXTENSIONS_DIR=../directus/extensions
