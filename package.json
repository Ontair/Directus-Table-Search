{
	"name": "directus-extension-table-search",
	"version": "0.1.0",
	"description": "Permission-aware Directus table layout with visible-column and relational search.",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build --watch --no-minify",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-custom-layout",
		"search",
		"table"
	],
	"license": "MIT",
	"directus:extension": {
		"type": "layout",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^11.12.0 || ^12.0.0"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "14.0.0",
		"@directus/types": "13.2.0",
		"@eslint/js": "9.35.0",
		"@types/node": "22.18.1",
		"@vitejs/plugin-vue": "5.2.3",
		"@vue/test-utils": "2.4.6",
		"eslint": "9.35.0",
		"eslint-plugin-vue": "10.4.0",
		"jsdom": "26.1.0",
		"prettier": "3.6.2",
		"sass": "1.92.1",
		"typescript": "5.8.3",
		"typescript-eslint": "8.42.0",
		"vitest": "3.2.4",
		"vue": "3.5.13",
		"vue-eslint-parser": "10.2.0",
		"vue-router": "4.5.0",
		"vue-tsc": "3.0.6"
	}
}
